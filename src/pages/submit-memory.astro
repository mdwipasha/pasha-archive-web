---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SubmitMemoryForm from "../components/SubmitMemoryForm.jsx";

const description =
  "Submit a photo, video, or memory for Pasha Archive, the personal archive of Muhamad Dwi Pasha.";
---

<Layout
  title="Submit Memory"
  description={description}
  canonicalPath="/submit-memory"
  keywords="submit memory, Pasha Archive, Muhamad Dwi Pasha"
>
  <Navbar />
  <main>
    <SubmitMemoryForm client:load />
  </main>
  <Footer />
</Layout>
