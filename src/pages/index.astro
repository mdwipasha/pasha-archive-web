---
import Layout from "../layouts/Layout.astro";

import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import RecentArchive from "../components/RecentArchive.astro";
import MemoriesMap from "../components/MemoriesMap";
import SubmitPageCTA from "../components/SubmitPageCTA.astro";
import Footer from "../components/Footer.astro";

const description =
  "Pasha Archive is the personal digital archive of Muhamad Dwi Pasha, known as Pasha, mdpashaaa, and mdwipasha.";
---

<Layout
  title="Pasha Archive"
  description={description}
  canonicalPath="/"
  keywords="Pasha Archive, Muhamad Dwi Pasha, Pasha, mdpashaaa, mdwipasha"
>
  <Navbar />

  <main>
    <Hero />
    <RecentArchive />
    <MemoriesMap client:only />
    <SubmitPageCTA />
  </main>
  <Footer />
</Layout>
