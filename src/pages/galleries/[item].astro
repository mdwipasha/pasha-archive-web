---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CommentSection from "../../components/Comments/CommentSection.jsx";

import { supabase } from "../../lib/supabase";

const { item } = Astro.params;
const { data, error } = await supabase
  .from("memories")
  .select("id, title, slug, type, src, thumbnail_url, description, date, year, location")
  .eq("slug", item)
  .maybeSingle();

if (error || !data) {
  return Astro.redirect("/404");
}

const [memoryTagsResult, memoryPeopleResult, commentsResult] = await Promise.all([
  supabase.from("memory_tags").select("tag_id").eq("memory_id", data.id),
  supabase.from("memory_people").select("person_id").eq("memory_id", data.id),
  supabase
    .from("memory_comments")
    .select("id, memory_id, username, comment, created_at, parent_id")
    .eq("memory_id", data.id)
    .order("created_at", { ascending: false }),
]);

const { data: memoryTagsData } = memoryTagsResult;
const tagIds = (memoryTagsData || []).map((row) => row.tag_id);
const { data: memoryPeopleData } = memoryPeopleResult;
const personIds = (memoryPeopleData || []).map((row) => row.person_id);
const [{ data: tagsData }, { data: peopleData }] = await Promise.all([
  tagIds.length
    ? supabase.from("tags").select("id, tag").in("id", tagIds)
    : Promise.resolve({ data: [] }),
  personIds.length
    ? supabase.from("people").select("id, name, social_media").in("id", personIds)
    : Promise.resolve({ data: [] }),
]);

const memory = {
  ...data,
  tags: (tagsData || []).map((tag) => tag.tag),
  people: (peopleData || []).map((person) => ({
    name: person.name,
    social: person.social_media,
    social_media: person.social_media,
  })),
};

const comments = commentsResult.data ?? [];

const memoryImage = memory.type === "Video" ? memory.thumbnail_url : memory.src;
const description =
  memory.description ||
  `${memory.title} from Pasha Archive, the personal archive of Muhamad Dwi Pasha.`;
const galleryItemSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `https://www.mdpashaaa.web.id/galleries/${memory.slug}#memory`,
  name: memory.title,
  description,
  image: memoryImage,
  url: `https://www.mdpashaaa.web.id/galleries/${memory.slug}`,
  creator: {
    "@type": "Person",
    name: "Muhamad Dwi Pasha",
    alternateName: ["Pasha", "mdpashaaa", "mdwipasha"],
  },
};
---

<Layout
  title={`${memory.title}`}
  description={description}
  canonicalPath={`/galleries/${memory.slug}`}
  image={memoryImage}
  type="article"
  jsonLd={galleryItemSchema}
>
  <Navbar />

  <main class="max-w-5xl mx-auto px-6 md:px-16 py-12">
    <div
      class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6"
    >
      <div class="relative inline-block">
        <div
          class="absolute -top-6 -left-4 w-24 h-8 bg-[#F6D1D8] opacity-60 scrapbook-tape -rotate-12 z-0"
        >
        </div>

        <h1
          class="font-[Space_Grotesk] text-5xl md:text-6xl font-bold text-black relative z-10"
        >
          {memory.title}
        </h1>
      </div>

      <a
        href="/galleries"
        class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 transition-transform active:scale-95 self-start"
      >
        <span class="material-symbols-outlined text-base leading-none">
          arrow_back
        </span>

        <span class="font-semibold text-sm"> Back to Gallery </span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <aside class="md:col-span-4 space-y-8">
        <div
          class="bg-white aspect-square p-2 border-2 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] rotate-[-1.5deg] relative"
        >
          {
            memory.type === "Video" ? (
              <img
                src={memory.thumbnail_url}
                alt={memory.title}
                loading="lazy"
                decoding="async"
                class="w-full aspect-square object-cover mb-4"
              />
            ) : (
              <img
                src={memory.src}
                alt={memory.title}
                loading="lazy"
                decoding="async"
                class="w-full aspect-square object-cover mb-4"
              />
            )
          }

          <div class="px-2 pb-2">
            <span class="text-[12px] uppercase tracking-[0.2em] text-slate-500">
              {memory.date || memory.year}
            </span>
          </div>
        </div>

        <div class="bg-[#BFD9FF]/20 p-6 border-2 border-black border-dashed">
          <h4 class="uppercase tracking-[0.2em] text-[11px] text-black mb-2">
            Archive Note
          </h4>

          <p class="text-base italic text-[#111111]">
            {memory.description}
          </p>
        </div>
      </aside>

      <div class="md:col-span-8">
        <CommentSection
          client:load
          memoryId={memory.id}
          initialComments={comments}
        />
      </div>
    </div>
  </main>

  <Footer />
</Layout>
